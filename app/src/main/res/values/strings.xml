<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-visible string in the app. Translations live in values-<code>/strings.xml for the
  eight languages the picker offers: hi, mr, bn, te, ta, gu, kn (English is this file).

  Nothing in a Composable may hard-code display text — the locale is overridden per-composition,
  not per-process, so a literal would survive a language change and be the one word left in English.
-->
