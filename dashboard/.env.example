# Shared secret the ESP32 must send as x-device-token. Leave unset for local
# development; set it on anything reachable from the internet.
DEVICE_TOKEN=

# Set to 0 to keep readings in memory only (no data/readings.ndjson on disk).
JALRAKSHA_PERSIST=1

# Where readings.ndjson is written.
JALRAKSHA_DATA_DIR=./data
